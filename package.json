{
  "name": "@webship-js/bootstrap-steps",
  "version": "2.0.1",
  "description": "Cucumber step definitions for the components of any site that uses Bootstrap 5.3 (and 4.6 where the same step holds), a plugin for webship-js (Playwright and Cucumber): dialogs, side panels, drop-down menus, panels and accordions, tabs, the navigation bar, alerts, notifications, carousels, tooltips, popovers, form validation states, list groups, pagination, breadcrumbs, badges, spinners and progress bars, each step waiting on the component's own events and states, never on a fixed time.",
  "main": "tests/step-definitions/bootstrap-helpers.js",
  "files": [
    "tests/step-definitions/",
    "tests/features/",
    "demo-site/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:paths": "node tests/check-paths.js",
    "test:must-fail": "node tests/check-must-fail.js",
    "test:v4": "LAUNCH_URL=${LAUNCH_URL:-http://127.0.0.1:8080}/4.6 CUCUMBER_TAGS='not @wip and not @must-fail and not @v5' cucumber-js --config cucumber.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "demo:serve": "npx --yes http-server@14.1.1 demo-site -p 8080 -s",
    "demo:start": "cd demo-site && ddev start",
    "demo:stop": "cd demo-site && ddev stop",
    "generate-reports": "generate-reports",
    "test:fast": "SLOW_MO=0 cucumber-js --config cucumber.js"
  },
  "keywords": [
    "webship-js",
    "bootstrap",
    "bootstrap5",
    "components",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "testing",
    "e2e",
    "gherkin"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/bootstrap-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/bootstrap-steps/issues"
  },
  "homepage": "https://github.com/webship/bootstrap-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 24.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.16"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "webship-js": "^2.0.16"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
